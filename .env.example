# ─────────────────────────────────────────────────────────────
# ViralForge.ai — Environment variables
# Copy this file to `.env` and fill in the values.
# ─────────────────────────────────────────────────────────────

# App URL (used for Stripe redirects, OG metadata, etc.)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ── Database (PostgreSQL) ────────────────────────────────────
# Local example: postgresql://postgres:postgres@localhost:5432/viralforge
# Render: copy the Internal Database URL from your Render Postgres instance.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/viralforge?schema=public"

# ── Auth ─────────────────────────────────────────────────────
# Strong random secret used to sign session JWTs.
# Generate one with: openssl rand -base64 32
AUTH_SECRET="replace-with-a-long-random-string"

# ── OpenAI ───────────────────────────────────────────────────
OPENAI_API_KEY="sk-..."
# Optional: defaults to gpt-4o-mini. Any model that supports JSON schema output.
OPENAI_MODEL="gpt-4o-mini"

# ── Stripe ───────────────────────────────────────────────────
# From https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY="sk_test_..."
# From `stripe listen` (local) or the webhook endpoint settings (production).
STRIPE_WEBHOOK_SECRET="whsec_..."

# Price IDs for each paid plan (create recurring monthly prices in Stripe).
STRIPE_PRICE_CREATOR="price_..."
STRIPE_PRICE_PRO="price_..."
STRIPE_PRICE_AGENCY="price_..."
