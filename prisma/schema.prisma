// ViralForge.ai — Prisma schema
// Database: PostgreSQL

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Plan {
  free
  creator
  pro
  agency
}

enum UserRole {
  USER
  ADMIN
}

enum TokenType {
  EMAIL_VERIFICATION
  PASSWORD_RESET
}

enum AgentRunStatus {
  pending
  success
  error
}

enum SocialPlatform {
  instagram
  youtube
  tiktok
}

model User {
  id               String    @id @default(cuid())
  email            String    @unique
  name             String?
  passwordHash     String
  emailVerified    DateTime?
  plan             Plan      @default(free)
  role             UserRole  @default(USER)
  stripeCustomerId String?   @unique
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  subscriptions      Subscription[]
  generations        Generation[]
  usages             Usage[]
  brandProfile       BrandProfile?
  verificationTokens VerificationToken[]
  agentRuns          AgentRun[]
  connectedAccounts  ConnectedAccount[]
  externalPosts      ExternalPost[]
}

model VerificationToken {
  id        String    @id @default(cuid())
  userId    String
  token     String    @unique
  type      TokenType
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Subscription {
  id                   String   @id @default(cuid())
  userId               String
  stripeSubscriptionId String   @unique
  stripeCustomerId     String
  status               String
  plan                 Plan
  currentPeriodEnd     DateTime?
  cancelAtPeriodEnd    Boolean  @default(false)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Generation {
  id         String   @id @default(cuid())
  userId     String
  inputText  String   @db.Text
  tone       String
  platforms  String[]
  outputJson Json
  title      String
  // Language the pack was generated in ("en" | "he"). Null on legacy rows —
  // regeneration then falls back to the active UI locale.
  contentLanguage String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  agentRuns     AgentRun[]
  externalPosts ExternalPost[]

  @@index([userId])
  @@index([createdAt])
}

// Runtime log for Creator Agent-assisted AI work. One row per tracked run.
model AgentRun {
  id               String         @id @default(cuid())
  userId           String
  agentType        String // "creator_agent"
  actionType       String // "generate_pack" | "regenerate_section"
  status           AgentRunStatus @default(pending)
  generationId     String?
  model            String?
  inputTokens      Int?
  outputTokens     Int?
  estimatedCostUsd Float?
  errorMessage     String?
  startedAt        DateTime       @default(now())
  completedAt      DateTime?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  generation Generation? @relation(fields: [generationId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([generationId])
  @@index([createdAt])
}

// Powers the user-facing "Creator Agent" feature (formerly Brand Voice).
model BrandProfile {
  id               String   @id @default(cuid())
  userId           String   @unique
  brandName        String?
  niche            String?
  audience         String?
  goals            String?
  defaultTone      String?
  sentenceLength   String?
  emojiUsage       String?
  ctaStyle         String?
  postingStyle     String?
  contentPillars   String[]
  vocabulary       String[]
  preferredPhrases String[]
  bannedPhrases    String[]
  primaryPlatforms String[]
  examplePosts     String?  @db.Text
  notes            String?  @db.Text
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Usage {
  id              String   @id @default(cuid())
  userId          String
  month           String // format: YYYY-MM
  generationCount Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, month])
  @@index([userId])
}

// A social account the user connected via the platform's official OAuth flow.
// Tokens are stored encrypted (AES-256-GCM, see src/lib/crypto.ts) — never
// returned to the client and never logged.
model ConnectedAccount {
  id                String         @id @default(cuid())
  userId            String
  platform          SocialPlatform
  externalAccountId String
  accountName       String?
  accessToken       String         @db.Text
  refreshToken      String?        @db.Text
  tokenExpiresAt    DateTime?
  status            String         @default("active") // "active" | "error"
  lastSyncedAt      DateTime?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  externalPosts ExternalPost[]

  @@unique([userId, platform, externalAccountId])
  @@index([userId])
}

// Maps a real post on a connected platform (and optionally the ViralForge
// generation it came from) so performance can be attributed over time.
model ExternalPost {
  id                 String         @id @default(cuid())
  userId             String
  generationId       String?
  connectedAccountId String
  platform           SocialPlatform
  externalPostId     String
  externalUrl        String?
  title              String?
  publishedAt        DateTime?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  user             User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  generation       Generation?      @relation(fields: [generationId], references: [id], onDelete: SetNull)
  connectedAccount ConnectedAccount @relation(fields: [connectedAccountId], references: [id], onDelete: Cascade)

  snapshots PostPerformanceSnapshot[]

  @@unique([connectedAccountId, externalPostId])
  @@index([userId])
  @@index([generationId])
}

// Point-in-time metrics for an external post. Fields are nullable because
// platforms expose different metrics — we store only what each API returns.
model PostPerformanceSnapshot {
  id             String   @id @default(cuid())
  externalPostId String
  views          Int?
  likes          Int?
  comments       Int?
  shares         Int?
  saves          Int?
  reach          Int?
  engagementRate Float?
  capturedAt     DateTime @default(now())
  createdAt      DateTime @default(now())

  externalPost ExternalPost @relation(fields: [externalPostId], references: [id], onDelete: Cascade)

  @@index([externalPostId, capturedAt])
}
